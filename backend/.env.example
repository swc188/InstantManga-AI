# AI 漫剧制作工作台后端环境变量模板
# 复制为 backend/.env 并填入真实值
# 配置前缀为 ACD_

# 数据库连接串（默认 backend/media/studio.db）
# ACD_DATABASE_URL=sqlite:///./media/studio.db

# 素材根目录（默认 backend/media）
# ACD_MEDIA_ROOT=./media

# 默认模型服务 Base URL（模型统一走 agnes-ai.cn）
ACD_DEFAULT_MODEL_BASE_URL=https://agnes-ai.cn

# 调试模式
# ACD_DEBUG=true
